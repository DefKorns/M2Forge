<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Forge.App.ViewModels"
             xmlns:conv="using:M2Forge.App.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="M2Forge.App.Views.RomsPage"
             x:DataType="vm:RomsViewModel">

    <Grid>
        <Grid IsVisible="{Binding HasRoms}" ColumnDefinitions="*,18,330">

            <Border Classes="card" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="16,16,16,10">
                        <Grid ColumnDefinitions="*,10,140,10,150,10,130">
                            <TextBox AutomationProperties.Name="Search games" Text="{Binding Search}" Watermark="Search games">
                                <TextBox.InnerLeftContent>
                                    <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <ComboBox AutomationProperties.Name="Filter by region" Grid.Column="2" ItemsSource="{Binding Regions}" SelectedItem="{Binding RegionFilter}" HorizontalAlignment="Stretch"/>
                            <ComboBox AutomationProperties.Name="Filter by language" Grid.Column="4" ItemsSource="{Binding Languages}" SelectedItem="{Binding LanguageFilter}" HorizontalAlignment="Stretch"/>
                            <ComboBox AutomationProperties.Name="Filter by file type" Grid.Column="6" ItemsSource="{Binding Formats}" SelectedItem="{Binding FormatFilter}" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                            <Button Classes="ghost" Padding="10,6" Command="{Binding SelectVisibleCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="CheckAll" Width="17" Height="17"/>
                                    <TextBlock Text="Select shown"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Classes="ghost" Padding="10,6" Command="{Binding ClearSelectionCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="CloseCircleOutline" Width="17" Height="17"/>
                                    <TextBlock Text="Clear"/>
                                </StackPanel>
                            </Button>
                            <ComboBox AutomationProperties.Name="File extension for exported .bin games" Grid.Column="3" ItemsSource="{Binding Extensions}" SelectedItem="{Binding Extension}" MinWidth="86"
                                      ToolTip.Tip="Extension for the .bin ROMs. Other formats (smd, smp, mcd) keep their own."/>
                            <CheckBox Grid.Column="4" Content="Overwrite" IsChecked="{Binding Overwrite}"
                                      ToolTip.Tip="Replace files that already exist in the export folder"/>
                            <Button Grid.Column="5" Classes="primary" Command="{Binding ExportSelectedCommand}" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="Export" Width="18" Height="18"/>
                                    <TextBlock Text="{Binding ExportLabel}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Classes="ghost" Padding="10,6" HorizontalAlignment="Left" Command="{Binding ExportBiosCommand}" IsVisible="{Binding HasBios}"
                                ToolTip.Tip="Saves the Mega CD BIOS from this firmware under the file names RetroArch looks for. Put them in its system folder.">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Chip" Width="17" Height="17"/>
                                <TextBlock Text="{Binding BiosLabel}"/>
                            </StackPanel>
                        </Button>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <CheckBox Content="Compress" IsChecked="{Binding CompressExports}"
                                      ToolTip.Tip="Mega Drive games are exported as .zip files and Sega CD games as .chd (needs chdman)"/>
                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding ChdmanText}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button Grid.Column="2" Classes="ghost" Padding="10,6" Command="{Binding ChooseChdmanCommand}"
                                    AutomationProperties.Name="Choose the chdman program used to compress discs">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="17" Height="17"/>
                                    <TextBlock Text="Choose chdman"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Padding="10,6" Command="{Binding ClearChdmanCommand}"
                                    IsVisible="{Binding HasChdmanChoice}" AutomationProperties.Name="Forget the chosen chdman">
                                <TextBlock Text="Forget"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Summary}" Classes="caption" VerticalAlignment="Center"/>
                            <ProgressBar AutomationProperties.Name="Working" Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasStatus}" Margin="16,0,16,12">
                        <Border Classes="note" Classes.error="{Binding StatusIsError}">
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
                        </Border>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="16,6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,1">
                        <Grid ColumnDefinitions="40,50,*,64,100,100,90">
                            <Button AutomationProperties.Name="Sort by title" Grid.Column="2" Classes="ghost" Padding="0,4" HorizontalAlignment="Left" Command="{Binding SortCommand}" CommandParameter="title">
                                <TextBlock Text="{Binding TitleHeader}" Classes="label"/>
                            </Button>
                            <Button AutomationProperties.Name="Sort by file type" Grid.Column="3" Classes="ghost" Padding="0,4" Command="{Binding SortCommand}" CommandParameter="format">
                                <TextBlock Text="{Binding FormatHeader}" Classes="label"/>
                            </Button>
                            <Button AutomationProperties.Name="Sort by region" Grid.Column="4" Classes="ghost" Padding="0,4" Command="{Binding SortCommand}" CommandParameter="region">
                                <TextBlock Text="{Binding RegionHeader}" Classes="label"/>
                            </Button>
                            <Button AutomationProperties.Name="Sort by language" Grid.Column="5" Classes="ghost" Padding="0,4" Command="{Binding SortCommand}" CommandParameter="language">
                                <TextBlock Text="{Binding LanguageHeader}" Classes="label"/>
                            </Button>
                            <Button AutomationProperties.Name="Sort by size" Grid.Column="6" Classes="ghost" Padding="0,4" HorizontalAlignment="Right" Command="{Binding SortCommand}" CommandParameter="size">
                                <TextBlock Text="{Binding SizeHeader}" Classes="label"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Classes="plain" ItemsSource="{Binding Rows}" SelectedItem="{Binding Current}" Margin="6,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RomRow">
                                <Grid ColumnDefinitions="40,50,*,64,100,100,90" Margin="10,0" MinHeight="62">
                                    <CheckBox AutomationProperties.Name="{Binding Title, StringFormat='Select {0}'}" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0"/>

                                    <Border AutomationProperties.AccessibilityView="Raw" Grid.Column="1" Width="38" Height="50" CornerRadius="4" ClipToBounds="True"
                                            Background="{DynamicResource LineBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Panel>
                                            <Image Source="avares://M2Forge.App/Assets/defkorns-head.png" Opacity="0.3" Margin="5" IsVisible="{Binding !IsBios}"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <mi:MaterialIcon Kind="Chip" Width="26" Height="26" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding IsBios}"/>
                                            <Image Source="{Binding Cover, Converter={x:Static conv:Converters.Image}}" Stretch="Uniform"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="4,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding Format}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border AutomationProperties.AccessibilityView="Raw" Width="22" Height="16" CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center">
                                            <Image Source="{Binding RegionFlag, Converter={x:Static conv:Converters.Flag}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Region}" Classes="muted" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border AutomationProperties.AccessibilityView="Raw" Width="22" Height="16" CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center" IsVisible="{Binding HasLanguageFlag}">
                                            <Image Source="{Binding LanguageFlag, Converter={x:Static conv:Converters.Flag}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Language}" Classes="muted" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="6" Text="{Binding SizeText}" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Classes="primary" Margin="0,16,0,0" Command="{Binding ExportCurrentCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="ContentSaveOutline" Width="18" Height="18"/>
                            <TextBlock Text="Export this ROM..."/>
                        </StackPanel>
                    </Button>

                    <ScrollViewer IsVisible="{Binding HasCurrent}">
                        <StackPanel Spacing="16">
                            <Border AutomationProperties.Name="{Binding Current.Title, StringFormat='Cover of {0}'}" HorizontalAlignment="Center" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource LineBrush}"
                                    MinWidth="150" MinHeight="150" MaxHeight="300" MaxWidth="240">
                                <Panel>
                                    <Image Source="avares://M2Forge.App/Assets/defkorns-head.png" Opacity="0.25" Width="90" Height="90" IsVisible="{Binding !Current.IsBios}"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    <mi:MaterialIcon Kind="Chip" Width="72" Height="72" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding Current.IsBios}"/>
                                    <Image Source="{Binding CurrentCover, Converter={x:Static conv:Converters.Image}}" Stretch="Uniform"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                </Panel>
                            </Border>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Current.Title}" Classes="heading" FontSize="17" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Current.NativeTitle}" Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding Current.NativeTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding Current.Info.FileName}" Classes="caption" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Border Classes="chip"><TextBlock Text="{Binding Current.Format}" FontWeight="Medium"/></Border>
                                    <Border Classes="chip">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="20" Height="14" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                                <Image Source="{Binding Current.RegionFlag, Converter={x:Static conv:Converters.Flag}}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Current.Region}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="chip" IsVisible="{Binding Current.HasLanguageFlag}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="20" Height="14" CornerRadius="2" ClipToBounds="True" VerticalAlignment="Center">
                                                <Image Source="{Binding Current.LanguageFlag, Converter={x:Static conv:Converters.Flag}}" Stretch="UniformToFill"/>
                                            </Border>
                                            <TextBlock Text="{Binding Current.Language}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="chip"><TextBlock Text="{Binding Current.SizeText}" FontWeight="Medium"/></Border>
                                </StackPanel>
                            </StackPanel>

                            <Border Classes="divider"/>

                            <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" IsVisible="{Binding HasCurrentHeader}">
                                <TextBlock Text="Name" Classes="label"/>
                                <TextBlock Grid.Column="1" Text="{Binding Current.Info.HeaderName}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Copyright" Classes="label"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Current.Info.Header.Copyright}"/>
                                <TextBlock Grid.Row="2" Text="Serial" Classes="label"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Current.Info.Header.Serial}"/>
                                <TextBlock Grid.Row="3" Text="Regions" Classes="label"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Current.Info.Header.Regions}"/>
                                <TextBlock Grid.Row="4" Text="Checksum" Classes="label"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentHeaderChecksum}"/>
                            </Grid>
                            <TextBlock Text="This file has no readable Mega Drive header." Classes="muted" IsVisible="{Binding !HasCurrentHeader}"/>

                            <Border Classes="divider"/>

                            <StackPanel Spacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="CRC32" Classes="label"/>
                                    <TextBlock Text="{Binding CrcText}" Classes="mono" IsVisible="{Binding CrcText.Length}"/>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="SHA-1" Classes="label"/>
                                    <TextBlock Text="{Binding Sha1Text}" Classes="mono" TextWrapping="Wrap" IsVisible="{Binding Sha1Text.Length}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding !HasCurrent}">
                        <mi:MaterialIcon Kind="GamepadVariantOutline" Width="40" Height="40" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pick a game to see its details" Classes="muted"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <Border IsVisible="{Binding ShowLoading}" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36" MinWidth="340">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <ProgressBar AutomationProperties.Name="Loading" IsIndeterminate="True" Width="240"/>
                <TextBlock Text="Loading the extracted files..." Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border IsVisible="{Binding ShowEmpty}" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36" MaxWidth="460">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="GamepadVariantOutline" Width="44" Height="44" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No ROMs found yet" Classes="heading" FontSize="17" HorizontalAlignment="Center"/>
                <TextBlock Text="Extract a firmware first, or open a folder you have already extracted. The games live in its system/roms folder."
                           Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Classes="primary" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center" Padding="20,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18"/>
                        <TextBlock Text="Open extracted folder..."/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
