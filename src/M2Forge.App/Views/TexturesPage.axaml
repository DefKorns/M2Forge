<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:M2Forge.App.ViewModels"
             xmlns:conv="using:M2Forge.App.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="M2Forge.App.Views.TexturesPage"
             x:DataType="vm:TexturesViewModel">

    <UserControl.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" DestinationRect="0,0,20,20">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource CardBrush}" Geometry="M0,0 H20 V20 H0 Z"/>
                    <GeometryDrawing Brush="{DynamicResource RaisedBrush}" Geometry="M0,0 H10 V10 H0 Z M10,10 H20 V20 H10 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <Grid>
        <Grid IsVisible="{Binding HasTextures}" ColumnDefinitions="240,14,*,14,310">

            <Border Classes="card" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="14,14,14,10">
                        <TextBox AutomationProperties.Name="Search images" Text="{Binding Search}" Watermark="Search images">
                            <TextBox.InnerLeftContent>
                                <mi:MaterialIcon Kind="Magnify" Width="17" Height="17" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                        <ItemsControl ItemsSource="{Binding Categories}" AutomationProperties.Name="Filter by kind of image">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CategoryChip">
                                    <Button Classes="pill" Classes.active="{Binding IsActive}" Content="{Binding Label}" Margin="0,0,6,6"
                                            Command="{Binding $parent[ItemsControl].((vm:TexturesViewModel)DataContext).SelectCategoryCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Label, StringFormat='Show {0}'}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="16,8,10,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Summary}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" Classes="ghost" Padding="8,6" Command="{Binding ExportAllCommand}" ToolTip.Tip="Export every image as PNG"
                                    AutomationProperties.Name="Export every image as PNG">
                                <mi:MaterialIcon Kind="Export" Width="17" Height="17"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Classes="plain" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Margin="6,0,6,6"
                             AutomationProperties.Name="Image sets">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TextureGroup">
                                <Grid ColumnDefinitions="*,Auto" Margin="8,4" MinHeight="44" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Classes="caption"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" Margin="8,0,2,0" Fill="{DynamicResource EditedBrush}"
                                             IsVisible="{Binding File.IsEdited}" ToolTip.Tip="Has edits"
                                             AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" IsVisible="{Binding HasGroup}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding SelectedGroup.Title}" Classes="heading" FontSize="16" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedGroup.Path}" Classes="caption" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <ListBox Classes="plain" ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}" Margin="10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasGroup}"
                             AutomationProperties.Name="Images in the selected set">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TextureTile">
                                <StackPanel Width="112" Spacing="4" Margin="2" AutomationProperties.Name="{Binding AccessibleName}">
                                    <Border Height="96" CornerRadius="8" ClipToBounds="True" Background="{StaticResource Checker}"
                                            BorderThickness="1" BorderBrush="{DynamicResource LineBrush}">
                                        <Panel>
                                            <Image Source="{Binding Thumbnail, Converter={x:Static conv:Converters.Image}}" Stretch="Uniform" Margin="6"
                                                   RenderOptions.BitmapInterpolationMode="MediumQuality"/>
                                            <Ellipse Width="9" Height="9" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Fill="{DynamicResource EditedBrush}" IsVisible="{Binding Node.IsEdited}" ToolTip.Tip="Has edits"/>
                                        </Panel>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" FontWeight="Medium" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Node.Detail}" Classes="caption" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding IsFilteredEmpty}">
                        <mi:MaterialIcon Kind="ImageSearchOutline" Width="42" Height="42" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No images match what you typed" Classes="muted" HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Classes="card">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,16,0,0">
                        <Border Classes="note" Classes.error="{Binding MessageIsError}" Classes.warn="{Binding !MessageIsError}" IsVisible="{Binding HasMessage}"
                                AutomationProperties.LiveSetting="Polite">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                        </Border>
                        <Button Classes="primary" Command="{Binding ReplaceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="ImageEditOutline" Width="18" Height="18"/>
                                <TextBlock Text="Replace with PNG..."/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RevertCommand}" IsVisible="{Binding HasOwnEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="UndoVariant" Width="18" Height="18"/>
                                <TextBlock Text="Revert to original"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Command="{Binding SavePngCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="ContentSaveOutline" Width="17" Height="17"/>
                                <TextBlock Text="Save as PNG..."/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer>
                        <StackPanel Spacing="14" Margin="0,0,8,0">
                            <Border Height="230" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                                    Background="{StaticResource Checker}" ClipToBounds="True">
                                <Panel>
                                    <Image AutomationProperties.Name="Preview of the selected image" Source="{Binding Preview}" Stretch="Uniform"
                                           IsVisible="{Binding Fit}" Margin="12" RenderOptions.BitmapInterpolationMode="None"/>
                                    <ScrollViewer IsVisible="{Binding ShowScrolling}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <Image AutomationProperties.Name="Preview of the selected image at full size" Source="{Binding Preview}" Stretch="None"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" RenderOptions.BitmapInterpolationMode="None"/>
                                    </ScrollViewer>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !CanEditSelection}">
                                        <mi:MaterialIcon Kind="ImageOutline" Width="38" Height="38" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Pick an image" Classes="muted"/>
                                    </StackPanel>
                                </Panel>
                            </Border>

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="8" Padding="3" IsVisible="{Binding HasAnyEdit}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <RadioButton Classes="segment" GroupName="view" Content="Original" IsChecked="{Binding ShowOriginal}"/>
                                        <RadioButton Classes="segment" GroupName="view" Content="Edited" IsChecked="{Binding ShowEdited}"/>
                                    </StackPanel>
                                </Border>
                                <ToggleButton Grid.Column="2" Classes="fit" IsChecked="{Binding Fit}" AutomationProperties.Name="Fit the image to the preview">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <mi:MaterialIcon Kind="FitToScreenOutline" Width="17" Height="17"/>
                                        <TextBlock Text="Fit"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding SelectionTitle}" Classes="heading" FontSize="16" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectionPath}" Classes="caption" TextWrapping="Wrap"/>
                                <Border Classes="chip edited" HorizontalAlignment="Left" IsVisible="{Binding HasOwnEdit}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource EditedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edited" FontWeight="Medium"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Classes="divider"/>

                            <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <TextBlock Text="Format" Classes="label"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormatText}"/>
                                <TextBlock Grid.Row="1" Text="Size" Classes="label"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SizeText}"/>
                                <TextBlock Grid.Row="2" Text="Position" Classes="label"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PositionText}"/>
                            </Grid>

                            <TextBlock Text="{Binding RequirementText}" Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border IsVisible="{Binding ShowLoading}" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36" MinWidth="340">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <ProgressBar AutomationProperties.Name="Loading" IsIndeterminate="True" Width="240"/>
                <TextBlock Text="Loading the extracted files..." Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border IsVisible="{Binding ShowEmpty}" Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,36" MaxWidth="460">
            <StackPanel Spacing="14" HorizontalAlignment="Center">
                <mi:MaterialIcon Kind="ImageMultipleOutline" Width="44" Height="44" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No images loaded yet" Classes="heading" FontSize="17" HorizontalAlignment="Center"/>
                <TextBlock Text="Extract a firmware first, or pick one you already imported on the Firmware page."
                           Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Classes="primary" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Center" Padding="20,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18"/>
                        <TextBlock Text="Open extracted folder..."/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
