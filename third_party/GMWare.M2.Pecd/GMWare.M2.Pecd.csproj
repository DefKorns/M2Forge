<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>GMWare.M2.Pecd</RootNamespace>
    <AssemblyName>GMWare.M2.Pecd</AssemblyName>
    <Authors>cyanic</Authors>
    <Description>Library for manipulating M2 CD images used in M2 mini consoles</Description>
    <Copyright>Copyright (C) 2020, 2022, 2024 Yukai Li</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>2.1.2</Version>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS8981;CS1998;CS0168;CS0219;CS0162;CS0649;CS0169;CS0414;SYSLIB0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="1.1.7" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="System.IO.Pipelines" Version="9.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CueSharp\CueSharp.csproj" />
  </ItemGroup>

</Project>
